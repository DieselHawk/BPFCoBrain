# BPFCo Brain - Environment Configuration
# Copy this to .env and fill in your values

# ===== PATHS =====
BRAIN_VAULT=./Brain
PORT=5000
DEBUG=False

# ===== GOOGLE OAUTH (Gmail + Google Drive) =====
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json

# ===== MICROSOFT AZURE (OneDrive) =====
ONEDRIVE_TOKEN=onedrive_token.json
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=common

# ===== ANTHROPIC (Claude AI) =====
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ===== MANUS PLATFORM =====
MANUS_API_URL=https://your-manus-instance.manus.space
MANUS_API_KEY=your-manus-api-key
