# BPFCo Brain - Environment Configuration
# Copy this to .env and fill in your values

# ===== PATHS =====
BRAIN_VAULT=./Brain
PORT=5000
DEBUG=False

# ===== BPFCO RUNTIME =====
# auto detects connectivity; online and offline explicitly select a mode.
BPFCO_BOOT_MODE=auto
BPFCO_NETWORK_MODE=offline
BPFCO_ONLINE_INTELLIGENCE=0
BPFCO_OFFLINE=1
BPFCO_OLLAMA_MODEL=hermes3:8b
BPFCO_OLLAMA_URL=http://127.0.0.1:11434/api/chat
BPFCO_HUMAN_APPROVAL=1
BPFCO_APPROVAL_USB=E:

# ===== AGENT PRESENCE / PERSONALITIES =====
BPFCO_FRED_VOICE=male
BPFCO_BOB_VOICE=male
BPFCO_CINDY_VOICE=female
BPFCO_KAI_VOICE=male
BPFCO_NEO_VOICE=male
BPFCO_PRESENCE_RENDERER=vrm

# ===== GOOGLE OAUTH (Gmail + Google Drive) =====
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json

# ===== MICROSOFT AZURE (OneDrive) =====
ONEDRIVE_TOKEN=onedrive_token.json
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=common

# ===== ANTHROPIC (Claude AI) =====
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ===== MANUS PLATFORM =====
MANUS_API_URL=https://your-manus-instance.manus.space
MANUS_API_KEY=your-manus-api-key
